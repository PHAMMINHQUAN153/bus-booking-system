Table users {
  id bigint [pk, increment]
  full_name nvarchar(100) [not null]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  phone varchar(20)
  role varchar(20) [not null, note: 'USER hoặc ADMIN']
  created_at datetime [not null]
}

Table routes {
  id bigint [pk, increment]
  origin nvarchar(100) [not null]
  destination nvarchar(100) [not null]
  distance_km int
  duration_minutes int
}

Table buses {
  id bigint [pk, increment]
  license_plate varchar(20) [unique, not null]
  bus_type nvarchar(50) [note: 'Giường nằm, Limousine...']
  total_seats int [not null]
}

Table seats {
  id bigint [pk, increment]
  bus_id bigint [not null]
  seat_number varchar(10) [not null]

  indexes {
    (bus_id, seat_number) [unique]
  }
}

Table trips {
  id bigint [pk, increment]
  route_id bigint [not null]
  bus_id bigint [not null]
  departure_time datetime [not null]
  price decimal(12,0) [not null]
  status varchar(20) [note: 'SCHEDULED, DEPARTED, CANCELLED']

  indexes {
    (route_id, departure_time)
  }
}

Table bookings {
  id bigint [pk, increment]
  user_id bigint [not null]
  trip_id bigint [not null]
  status varchar(20) [not null, note: 'PENDING, CONFIRMED, CANCELLED']
  total_price decimal(12,0)
  created_at datetime [not null]
  expires_at datetime [note: 'Hết hạn giữ ghế (PENDING)']
}

Table booking_seats {
  id bigint [pk, increment]
  booking_id bigint [not null]
  trip_id bigint [not null]
  seat_id bigint [not null]

  indexes {
    (trip_id, seat_id) [unique, note: 'Chống đặt trùng ghế']
  }
}

Table payments {
  id bigint [pk, increment]
  booking_id bigint [not null]
  amount decimal(12,0) [not null]
  method varchar(30)
  status varchar(20) [note: 'PENDING, SUCCESS, FAILED']
  paid_at datetime
}

Ref: seats.bus_id > buses.id
Ref: trips.route_id > routes.id
Ref: trips.bus_id > buses.id
Ref: bookings.user_id > users.id
Ref: bookings.trip_id > trips.id
Ref: booking_seats.booking_id > bookings.id
Ref: booking_seats.trip_id > trips.id
Ref: booking_seats.seat_id > seats.id
Ref: payments.booking_id > bookings.id